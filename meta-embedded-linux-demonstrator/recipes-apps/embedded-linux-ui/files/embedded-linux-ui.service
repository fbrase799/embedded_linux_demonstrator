[Unit]
Description=Embedded Linux Demonstrator UI
After=systemd-user-sessions.service data.mount local-fs.target systemd-modules-load.service
Wants=data.mount systemd-modules-load.service

[Service]
Type=simple
User=root
Restart=always
RestartSec=2
TimeoutStartSec=90
WorkingDirectory=/
StandardOutput=journal
StandardError=journal
ExecStart=/usr/bin/embedded-linux-ui-start

[Install]
WantedBy=multi-user.target
